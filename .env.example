# Copy to .env (never commit .env).
# fake = no keys needed (scripted speech, keyword decider)
CTQ_STT=fake
CTQ_DECIDER=fake
# 0 = demo calls replay instantly, 1 = real-time-ish
CTQ_DEMO_SPEED=1.0

# While the caller is still talking, decide again on the partial transcript at most this often (seconds); 0 = final segments only
CTQ_PARTIAL_DECIDE_SECS=2.5

# Real services (adapters in app/adapters/)
ELEVENLABS_API_KEY=
JEV_API_KEY=
# Biases speech recognition towards the invented car model names
ELEVENLABS_KEYTERMS=Atto,Vera,Ridge
# Pause that ends an utterance, 0.192-3.0
ELEVENLABS_VAD_SILENCE_SECS=0.4

# Optional; only used by `python -m eval decider --decider sonnet` for the speed/accuracy comparison
# ANTHROPIC_API_KEY=
